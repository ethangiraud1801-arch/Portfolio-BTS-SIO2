---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import FeedArticle from '../components/FeedArticle.astro';
import feedCache from '../data/feed-cache.json';
import { analyses } from '../data/analyses';
const articles = feedCache.articles as {title:string;source:string;date:string;summary:string;url:string;category:string}[];
const visibleArticles = articles.slice(0, 14);
const extraArticles = articles.slice(14);
const date = (value: string) => new Intl.DateTimeFormat('fr-FR', { day:'numeric', month:'long', year:'numeric', timeZone:'Europe/Paris' }).format(new Date(value));
---
<BaseLayout title="Veille technologique" description="Veille d’Ethan GIRAUD sur les réseaux et la cybersécurité : articles RSS et futures analyses personnelles." current="/veille/">
  <PageHeader icon="radar" label="Veille technologique" title="Réseaux & cybersécurité" description="Une sélection de publications issues de flux spécialisés, accompagnée à terme de mes propres analyses." />
  <section class="shell content-section veille-overview" aria-label="Démarche de veille"><div class="surface-card overview-main"><span class="feature-icon"><Icon name="radar" /></span><div><span class="overline">Ma démarche</span><h2>Suivre, sélectionner, approfondir</h2><p>Les sources configurées sont relevées automatiquement. Les liens ci-dessous m’aident à suivre les publications et à identifier des sujets pour de futures analyses personnelles.</p></div></div><div class="surface-card overview-update"><span class="overline">Dernière collecte</span><strong>{feedCache.updatedAt ? date(feedCache.updatedAt) : 'À effectuer'}</strong><p>Les articles restent consultables même lorsqu’un flux est temporairement indisponible.</p></div></section>
  <section class="shell content-section articles-section" aria-labelledby="articles-title">
    <div class="section-head"><div><span class="overline">Sources externes</span><h2 id="articles-title">Articles des flux</h2></div><span class="result-count">{articles.length} article{articles.length > 1 ? 's' : ''}</span></div>
    {articles.length ? <>
      <div class="article-list">{visibleArticles.map(article => <FeedArticle article={article} />)}</div>
      {extraArticles.length > 0 && <details class="article-expander">
        <summary><span class="article-expander-more">Voir plus</span><span class="article-expander-less">Voir moins</span><Icon name="arrow" size={18} /></summary>
        <div class="article-list">{extraArticles.map(article => <FeedArticle article={article} />)}</div>
      </details>}
    </> : <div class="surface-card empty-state"><span class="feature-icon"><Icon name="radar" /></span><h3>Les articles arrivent bientôt</h3><p>La première collecte RSS n’a pas encore été effectuée. La configuration des sources est décrite dans le README.</p></div>}
  </section>
  <section class="shell content-section analyses-section" aria-labelledby="analyses-title"><div class="section-head"><div><span class="overline">Rédaction personnelle</span><h2 id="analyses-title">Mes analyses</h2></div></div>{analyses.length ? <div class="article-list">{analyses.map(item => <article class="surface-card feed-card personal-card"><div class="article-meta"><span>Analyse personnelle</span><time datetime={item.date}>{date(item.date)}</time></div><h3><a href={item.url}>{item.title}<Icon name="arrowUp" size={19} /></a></h3><p>{item.summary}</p></article>)}</div> : <div class="surface-card empty-state personal-empty"><span class="feature-icon"><Icon name="book" /></span><h3>Analyses à venir</h3><p>Cette section accueillera mes articles une fois rédigés.</p></div>}</section>
</BaseLayout>
