---
import Icon from './Icon.astro';
interface Props { icon: 'briefcase' | 'folder' | 'radar' | 'user' | 'mail' | 'server'; label: string; title: string; description: string }
const { icon, label, title, description } = Astro.props;
---
<section class="page-header shell">
  <div class="section-kicker"><span class="icon-tile"><Icon name={icon} size={19} /></span><span>{label}</span></div>
  <h1>{title}</h1>
  <p>{description}</p>
</section>
